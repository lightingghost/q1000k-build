# Dedicated RAM bench; never the normal UBI device profile.
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# CONFIG_TARGET_airoha_an7581_DEVICE_quantum_q1000k-ubi is not set
# CONFIG_TARGET_airoha_an7581_DEVICE_quantum_q1000k-xgspon-bench is not set
CONFIG_TARGET_airoha_an7581_DEVICE_quantum_q1000k-xgspon-activation=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.0.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.0.255"
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_PACKAGE_q1000k-xgspon-bench=y
CONFIG_PACKAGE_luci-ssl=y
# CONFIG_SIGN_EACH_PACKAGE is not set
CONFIG_PACKAGE_q1000k-xgspon-validation=y
